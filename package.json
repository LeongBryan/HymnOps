{
  "name": "hymnops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:index && vite",
    "validate-no-lyrics": "tsx scripts/validate-no-lyrics.ts",
    "validate": "tsx scripts/validate-data.ts",
    "build:index": "tsx scripts/build-index.ts",
    "build": "npm run validate-no-lyrics && npm run validate && npm run build:index && vite build",
    "preview": "vite preview",
    "build:embeddings:local": "tsx scripts/build-embeddings.local.ts",
    "import:series": "tsx --env-file .env.local scripts/import-series-to-supabase.ts",
    "import:songs": "tsx --env-file .env.local scripts/import-songs-to-supabase.ts",
    "import:services": "tsx --env-file .env.local scripts/import-services-to-supabase.ts",
    "import:all": "npm run import:series && npm run import:songs && npm run import:services"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "date-fns": "^3.6.0",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
